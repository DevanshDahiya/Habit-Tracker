<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HabitTracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div class="bg-blobs" aria-hidden="true">
        <div class="blob blob1"></div>
        <div class="blob blob2"></div>
        <div class="blob blob3"></div>
        <div class="blob blob4"></div>
    </div>
    <header>
        <nav class="navbar navbar-expand-lg navbar-habit sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-stars"></i> HabitTracker</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navHabit">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navHabit">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-heart me-1"></i>Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Habits" asp-action="Index"><i class="bi bi-check2-square me-1"></i>Habits</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Calendar" asp-action="Index"><i class="bi bi-calendar-week me-1"></i>Calendar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Kanban" asp-action="Index"><i class="bi bi-kanban me-1"></i>Kanban</a></li>
                        @if (User.IsInRole("Admin")) {
                            <li class="nav-item"><a class="nav-link" asp-controller="AdminUsers" asp-action="Index"><i class="bi bi-shield-lock me-1"></i>Admin</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success shadow-sm rounded-3 mt-3">@TempData["SuccessMessage"]</div> }
        @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger shadow-sm rounded-3 mt-3">@TempData["ErrorMessage"]</div> }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="footer-habit py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <h5 class="text-white fw-bold"><i class="bi bi-stars text-warning"></i> HabitTracker</h5>
                    <p class="small">Build better habits. Visual calendar, Kanban board and role-based tracking — all in one beautiful ASP.NET MVC app.</p>
                    <p class="small">Made with <i class="bi bi-heart-fill text-danger"></i> for Group 17</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-white">Explore</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Habits" asp-action="Index">My Habits</a></li>
                        <li><a asp-controller="Calendar" asp-action="Index">Calendar Progress</a></li>
                        <li><a asp-controller="Kanban" asp-action="Index">Kanban Workflow</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white">Tip</h6>
                    <p class="small">Mark habits daily in Calendar, move them on Kanban, and watch your streak grow <i class="bi bi-fire text-warning"></i></p>
                    <span class="badge-gradient">Daily • Weekly • Custom</span>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-4" />
            <div class="text-center small">&copy; 2026 HabitTracker • Built with ASP.NET Core 10 • <a asp-controller="Home" asp-action="Privacy">Privacy</a></div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
