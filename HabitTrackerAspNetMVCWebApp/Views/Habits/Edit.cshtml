@model HabitTrackerAspNetMVCWebApp.Models.Habit
@{
    ViewData["Title"] = "Edit Habit 🎨";
}
<div class="fun-header p-4 mb-4" style="background: linear-gradient(135deg, #00CEC9, #6C5CE7 70%);">
    <h1 class="fw-bold"><i class="bi bi-pencil-square"></i> Edit: @Model.Title</h1>
    <p class="mb-0 opacity-90">Update your habit — keep it colorful and keep the streak!</p>
</div>
<div class="row g-4">
    <div class="col-lg-8"><div class="glass-card p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id"/>
            @if(ViewBag.Users != null){
                <div class="mb-3"><label class="form-label fw-bold">Owner</label><select name="ownerUserId" class="form-select rounded-3" asp-items="ViewBag.Users"></select></div>
            }
            <div class="mb-3"><label asp-for="Title" class="form-label fw-bold"></label><input asp-for="Title" class="form-control rounded-3 border-2"/></div>
            <div class="mb-3"><label asp-for="Description" class="form-label fw-bold"></label><textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea></div>
            <div class="row g-3">
                <div class="col-md-4"><label asp-for="Frequency" class="form-label fw-bold"></label><select asp-for="Frequency" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<Frequency>()"></select></div>
                <div class="col-md-4"><label asp-for="Status" class="form-label fw-bold"></label><select asp-for="Status" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<HabitStatus>()"></select></div>
                <div class="col-md-4"><label asp-for="KanbanStatus" class="form-label fw-bold"></label><select asp-for="KanbanStatus" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<KanbanStatus>()"></select></div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-6"><label asp-for="StartDate" class="form-label fw-bold"></label><input asp-for="StartDate" type="date" class="form-control rounded-3"/></div>
                <div class="col-md-6"><label asp-for="EndDate" class="form-label fw-bold"></label><input asp-for="EndDate" type="date" class="form-control rounded-3"/></div>
            </div>
            <div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-gradient rounded-pill"><i class="bi bi-check-circle me-1"></i> Save Changes</button><a asp-action="Index" class="btn btn-ghost rounded-pill">Back</a></div>
        </form>
    </div></div>
    <div class="col-lg-4"><div class="glass-card p-3 text-center"><img src="https://images.unsplash.com/photo-1612036782180-6f0b6cd846fe?w=400&auto=format&fit=crop&q=80" class="w-100 rounded-3" style="height:200px;object-fit:cover" alt="anime edit"/><p class="small text-muted mt-2">Tip: Change Kanban to <b>Done</b> to auto-log today as Completed!</p><img src="https://media.giphy.com/media/xT5LMHxhOfscxPfIfm/giphy.gif" style="width:100%;height:120px;object-fit:cover;border-radius:12px" alt="gif" onerror="this.style.display='none'"/></div></div>
</div>
