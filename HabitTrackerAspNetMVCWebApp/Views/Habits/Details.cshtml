@model HabitTrackerAspNetMVCWebApp.Models.Habit
@{
    ViewData["Title"] = Model.Title + " ✨";
}
<div class="habit-card">
    <div class="habit-card-top" style="height:200px"><img src="https://images.unsplash.com/photo-1578632292335-df3ab3100d00?w=800&auto=format&fit=crop&q=80" alt="anime detail"/><span class="chip"><i class="bi bi-fire text-danger"></i> Habit Details</span></div>
    <div class="p-4">
        <h1 class="fw-bold" style="color:#6C5CE7">@Model.Title <span class="badge-fun @(Model.Status==HabitStatus.Completed?"badge-completed":"badge-active")">@Model.Status</span></h1>
        <p class="text-muted">@Model.Description</p>
        <div class="row g-3 mt-2">
            <div class="col-md-3"><div class="glass-card p-3 text-center"><i class="bi bi-repeat fs-4 text-primary"></i><div class="fw-bold">@Model.Frequency</div><small class="text-muted">Frequency</small></div></div>
            <div class="col-md-3"><div class="glass-card p-3 text-center"><i class="bi bi-kanban fs-4" style="color:#FD79A8"></i><div class="fw-bold">@Model.KanbanStatus</div><small class="text-muted">Kanban</small></div></div>
            <div class="col-md-3"><div class="glass-card p-3 text-center"><i class="bi bi-calendar-event fs-4 text-success"></i><div class="fw-bold">@Model.StartDate.ToString("MMM dd, yyyy")</div><small class="text-muted">Start</small></div></div>
            <div class="col-md-3"><div class="glass-card p-3 text-center"><i class="bi bi-person fs-4 text-warning"></i><div class="fw-bold small">@Model.User?.Email</div><small class="text-muted">Owner</small></div></div>
        </div>
        <div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gradient rounded-pill"><i class="bi bi-pencil me-1"></i> Edit</a><a asp-action="Index" class="btn btn-ghost rounded-pill">Back to Habits</a><img src="https://media.giphy.com/media/3o7aCTfyhYawdOXcFW/giphy.gif" style="width:100px;height:70px;object-fit:cover;border-radius:12px" alt="gif" onerror="this.style.display='none'" class="ms-auto"/></div>
    </div>
</div>
