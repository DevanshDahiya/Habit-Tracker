@model HabitTrackerAspNetMVCWebApp.Models.Habit
@{
    ViewData["Title"] = "Delete?";
}
<div class="glass-card p-4 text-center" style="border:2px dashed #FD79A8">
    <img src="https://media.giphy.com/media/3o7TKQ8kAP0f9X5PoY/giphy.gif" style="max-width:220px;border-radius:16px" alt="sad gif" onerror="this.style.display='none'"/>
    <h2 class="fw-bold mt-3">Delete <span style="color:#e84393">@Model.Title</span>?</h2>
    <p class="text-muted">This will remove the habit and its logs. This cute habit will be gone!</p>
    <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=400&auto=format&fit=crop&q=80" class="rounded-3 my-2" style="width:220px;height:140px;object-fit:cover" alt="anime sad"/>
    <form asp-action="Delete" method="post" class="mt-3"><input type="hidden" asp-for="Id"/><button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold"><i class="bi bi-trash me-1"></i> Yes, Delete</button> <a asp-action="Index" class="btn btn-ghost rounded-pill">Cancel</a></form>
</div>
