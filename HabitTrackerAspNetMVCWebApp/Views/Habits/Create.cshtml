@model HabitTrackerAspNetMVCWebApp.Models.Habit
@{
    ViewData["Title"] = "Create Habit ✨";
}
<div class="fun-header p-4 mb-4">
    <div class="row align-items-center g-3">
        <div class="col-lg-7">
            <h1 class="fw-bold mb-1"><i class="bi bi-stars"></i> Create a New Habit</h1>
            <p class="mb-0 opacity-90">Make it fun, make it colorful — choose frequency, status and watch it become an anime card!</p>
        </div>
        <div class="col-lg-5 text-center"><img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=500&auto=format&fit=crop&q=80" class="anime-float w-100" style="max-height:180px;object-fit:cover" alt="anime create" /></div>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                @if(ViewBag.Users != null){
                    <div class="mb-3"><label class="form-label fw-bold">Owner <span class="badge bg-warning text-dark">Admin</span></label><select name="ownerUserId" class="form-select rounded-3" asp-items="ViewBag.Users"></select></div>
                }
                <div class="mb-3"><label asp-for="Title" class="form-label fw-bold"></label><input asp-for="Title" class="form-control rounded-3 border-2" placeholder="e.g. Morning Yoga 🧘‍♀️"/><span asp-validation-for="Title" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Description" class="form-label fw-bold"></label><textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Why is this habit kawaii?"></textarea></div>
                <div class="row g-3">
                    <div class="col-md-4"><label asp-for="Frequency" class="form-label fw-bold"></label><select asp-for="Frequency" class="form-select rounded-3" style="background:#FFF9DB" asp-items="Html.GetEnumSelectList<Frequency>()"></select></div>
                    <div class="col-md-4"><label asp-for="Status" class="form-label fw-bold"></label><select asp-for="Status" class="form-select rounded-3" style="background:#E0FFF5" asp-items="Html.GetEnumSelectList<HabitStatus>()"></select></div>
                    <div class="col-md-4"><label asp-for="KanbanStatus" class="form-label fw-bold"></label><select asp-for="KanbanStatus" class="form-select rounded-3" style="background:#F3E8FF" asp-items="Html.GetEnumSelectList<KanbanStatus>()"></select></div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6"><label asp-for="StartDate" class="form-label fw-bold"></label><input asp-for="StartDate" type="date" class="form-control rounded-3" value="@DateTime.Today.ToString("yyyy-MM-dd")"/></div>
                    <div class="col-md-6"><label asp-for="EndDate" class="form-label fw-bold"></label><input asp-for="EndDate" type="date" class="form-control rounded-3"/></div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-gradient btn-lg rounded-pill"><i class="bi bi-magic me-1"></i> Create Habit</button>
                    <a asp-action="Index" class="btn btn-ghost rounded-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="glass-card p-3 text-center">
            <img src="https://media.giphy.com/media/3o7TKMt1VVNkHV2PaE/giphy.gif" style="width:100%;height:180px;object-fit:cover;border-radius:14px" alt="anime gif" onerror="this.style.display='none'" />
            <h6 class="fw-bold mt-3">Anime inspo ✨</h6>
            <p class="small text-muted">Each habit gets a random anime cover on the list — collect them all!</p>
            <img src="https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=400&auto=format&fit=crop&q=80" class="w-100 rounded-3 mt-2" style="height:130px;object-fit:cover" alt="anime" />
            <div class="mt-3 d-flex gap-1 justify-content-center flex-wrap"><span class="badge-fun badge-daily">Daily</span><span class="badge-fun badge-weekly">Weekly</span><span class="badge-fun badge-active">Active</span></div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
